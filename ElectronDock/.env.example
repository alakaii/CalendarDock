# Copy this file to .env and fill in your values
# .env is gitignored — never commit the actual .env file

# Google OAuth credentials
# Create at: https://console.cloud.google.com > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Application type: Desktop app
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Tesla Fleet API credentials
# Register at: https://developer.tesla.com > Apps
# Allowed Origin URL must point at a domain you control (used to host the
# public key at /.well-known/appspecific/com.tesla.3p.public-key.pem)
TESLA_FLEET_CLIENT_ID=your_client_id_here
TESLA_FLEET_CLIENT_SECRET=your_client_secret_here
